{
  "name": "@spektra/layouts",
  "version": "0.1.0",
  "description": "Page templates — layout compositions for Spektra apps",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist *.tsbuildinfo",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@spektra/types": "workspace:*",
    "@spektra/runtime": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
